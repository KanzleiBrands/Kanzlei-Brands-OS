generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum OrganizationType {
  AGENCY // Kanzlei Brands itself (top of the tree, manages every client)
  CLIENT // A customer of Kanzlei Brands, has its own leads/applicants/staff
}

model Organization {
  id   String           @id @default(cuid())
  type OrganizationType
  name String
  slug String           @unique

  // Branding (client orgs can override the agency defaults)
  logoUrl      String?
  primaryColor String?

  // Client orgs can be archived instead of deleted; archived orgs are hidden
  // from the default Kunden-Übersicht and can be reactivated at any time.
  archivedAt DateTime?

  // Gebuchte Kampagnen-Kontingente je Kampagnentyp - null bedeutet bewusst
  // "kein Limit gesetzt" (von der Agentur explizit für einen Kunden
  // gewählt), Default für neue Kunden ist 0 statt null: ein frisch
  // angelegter Kunde hat noch nichts gebucht und darf daher nicht per
  // Self-Serve-Formular eine erste Kampagne einreichen können, bevor die
  // Agentur überhaupt ein Kontingent freigegeben hat (siehe
  // CampaignRequestCard.quotaExhausted). "In Gebrauch" wird nicht separat
  // gespeichert, sondern immer live aus der Anzahl vorhandener
  // Pipeline-Zeilen dieses Kunden je PipelineKind berechnet, damit Löschen
  // einer Kampagne das Kontingent automatisch wieder freigibt.
  leadsQuota      Int? @default(0)
  applicantsQuota Int? @default(0)

  // Cashflow Cockpit (nur intern, Geschäftsführung) - Jahresziel für den
  // Fortschrittsbalken. Cash-In kommt live aus EasyBill (siehe
  // src/lib/easybill/client.ts), Cash-Out ist ein Transaktions-Ledger
  // (CashflowCostEntry). cashflowTaxReservePercent ist der Anteil vom
  // Operating Cashflow, der als Steuerrücklage abgezogen wird ("Cashflow BIT").
  profitGoalAnnual          Int?
  cashflowTaxReservePercent Float?

  // EasyBill-Kunden-ID dieser Organisation (nur bei CLIENT-Orgs gesetzt) -
  // ordnet EasyBill-Rechnungen im Cashflow Cockpit einem echten Kunden aus
  // dem Kundenportal zu. Nicht jede EasyBill-Rechnung hat zwangsläufig eine
  // passende Organisation hier (z.B. Kunde nutzt das Portal nicht) - ohne
  // Mapping wird einfach der EasyBill-Firmenname angezeigt.
  easybillCustomerId Int? @unique

  // Kundenspezifische Jotform-URLs (Stellenformular / Mandatsakquise-Briefing,
  // an Airtable gekoppelt) - der Kunde nutzt diese selbst, um im Rahmen
  // seines Kontingents eine weitere Kampagne einzureichen.
  leadsFormUrl      String?
  applicantsFormUrl String?

  // Zuständiger Agentur-Mitarbeiter, an den eine Anfrage geht, wenn der
  // Kunde weitere Kontingente beauftragen möchte - auch im Kunden-Hub als
  // Ansprechpartner mit Telefon/E-Mail/Calendly-Terminbuchung angezeigt.
  accountManagerId String?
  accountManager   User?   @relation("AccountManagerFor", fields: [accountManagerId], references: [id], onDelete: SetNull)

  // Zuständiger Ansprechpartner für Buchhaltung/Backoffice (Rechnungen,
  // Vertragswesen). Anders als der Account Manager portalweit einheitlich -
  // es gibt nur eine Buchhaltung für alle Kunden -, daher nur auf der
  // einzelnen AGENCY-Organisation gepflegt (siehe updatePortalBackofficeContact)
  // und im Kunden-Hub jedes Kunden gleichermaßen angezeigt.
  backofficeContactId String?
  backofficeContact   User?   @relation("BackofficeContactFor", fields: [backofficeContactId], references: [id], onDelete: SetNull)

  // Kunden-Hub: Ressourcen-Links, die dem Kunden direkt zugänglich gemacht
  // werden - jeweils nur sichtbar, wenn gesetzt, damit ein Kunde ohne z.B.
  // LinkedIn-Kampagne nicht auf einen leeren Link stößt und denkt, er hätte
  // das gebucht, aber nicht bekommen.
  driveFolderUrl       String?
  landingPageUrl       String?
  metaAdLibraryUrl     String?
  linkedInAdLibraryUrl String?

  // Kunden-Hub "Angebote": welche Pakete/Produkte dieser Kunde bereits
  // gebucht hat (freie Tags, siehe Offer.productTag) - ein Angebot mit
  // passendem productTag wird diesem Kunden dann nicht mehr als Upsell
  // vorgeschlagen, weil er es schon hat.
  bookedProductTags String[] @default([])

  // Kunden-Hub "Potenzialscore": welche Vertriebs-/Marketingkanäle der
  // Kunde für seine gebuchte Recruiting- bzw. Mandatsakquise-Kampagne
  // aktuell tatsächlich nutzt (freie Tags, siehe src/lib/growth-levers.ts) -
  // fehlende Kanäle senken den Score und werden als konkrete
  // Handlungsempfehlung angezeigt.
  activeApplicantChannels String[] @default([])
  activeLeadChannels      String[] @default([])

  // Set when this org was created or matched by the Airtable "Kunden" sync,
  // so re-deliveries of the same Airtable record update instead of duplicate.
  airtableRecordId String? @unique

  // Unternehmensdaten (Personal-Bereich -> Unternehmen) - nur auf der
  // AGENCY-Organisation gepflegt, siehe /dashboard/intern/personal/unternehmen.
  companyWebsite String?
  businessNumber String? // Betriebsnummer
  vatId          String? // Umsatzsteuer-ID
  foundedYear    Int?
  mission        String?

  parentId String?
  parent   Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrgHierarchy")

  // Monatlicher Performance-Report per E-Mail an die Kunden-Admins - läuft
  // immer am letzten Kalendertag des Monats, unabhängig davon wann der
  // Kunde angelegt wurde (ein Kunde von Mitte des Monats bekommt dadurch
  // automatisch seinen ersten Report nach ~2 Wochen). Default an, damit die
  // Agentur es bewusst pro Kunde abschalten muss statt es aktivieren zu müssen.
  monthlyReportEnabled Boolean   @default(true)
  lastReportSentAt     DateTime?

  // DSGVO: Kontakte in einer Ungeeignet-/Verloren-Stufe (Stage.isRejected)
  // nach X Monaten vollständig löschen (nicht nur anonymisieren - entweder
  // der ganze Datensatz oder gar nichts). Gilt kundenweit für alle
  // Kampagnen dieses Typs, damit es nicht pro Kampagne einzeln gepflegt
  // werden muss. null = deaktiviert - bewusst nicht standardmäßig aktiv, da
  // dies echte Kontaktdaten unwiderruflich löscht; muss von der Agentur
  // bewusst pro Kunde gesetzt werden. Für den Kunden selbst nur sichtbar,
  // nicht änderbar (siehe /dashboard/settings, Reiter "Datenschutz").
  //
  // Recruiting: Empfehlung 6 Monate, siehe AGG §15 Abs. 4 (2 Monate
  // Klagefrist für Entschädigungsansprüche nach Absage) + §61b ArbGG
  // (weitere 3 Monate Klagefrist) + Sicherheitspuffer.
  applicantDataRetentionMonths Int?
  // Mandatsakquise: keine gesetzliche Mindestfrist für Anfragen ohne
  // zustande gekommenes Mandat, siehe Grundsatz der Speicherbegrenzung
  // (Art. 5 Abs. 1 lit. e DSGVO) - Empfehlung in der Praxis 6 Monate.
  leadDataRetentionMonths      Int?

  users                     User[]
  pipelines                 Pipeline[]
  courseAssignments         CourseAssignment[]
  webhookEndpoints          WebhookEndpoint[]
  metaLeadFormConnections   MetaLeadFormConnection[]
  socialChannels            SocialChannel[]
  socialPosts               SocialPost[]
  whatsAppChannels          WhatsAppChannel[]
  auditLogs                 AuditLog[]
  messageTemplates          MessageTemplate[]
  talentPools               TalentPool[]
  partnerPointsTransactions PartnerPointsTransaction[]
  marketingTags             MarketingTag[]
  marketingSubscribers      MarketingSubscriber[]
  marketingListWebhooks     MarketingListWebhook[]
  marketingFunnels          MarketingFunnel[]
  cashflowCostEntries       CashflowCostEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Users & access
// ---------------------------------------------------------------------------

enum UserRole {
  AGENCY_ADMIN // Kanzlei Brands staff, full control over every client org
  AGENCY_STAFF // Nicht-Fulfillment Kanzlei-Brands-Mitarbeiter (Vertrieb, Backoffice, ...) - nur das interne Portal, kein Zugriff auf Kunden/CRM
  CLIENT_ADMIN // Owner-level user at a client org, manages that org's staff/pipelines
  CLIENT_STAFF // Employee at a client org, access limited to assigned pipelines
}

// Abteilung eines Agentur-Mitarbeiters - bestimmt, welchen Hub er im internen
// Portal sieht (siehe getDepartmentHubPage). Pflichtfeld für AGENCY_STAFF;
// bei AGENCY_ADMIN optional gesetzt, um zusätzlich zur Kunden-Verwaltung
// einen eigenen persönlichen Hub zu bekommen (z.B. Geschäftsführung).
enum AgencyDepartment {
  SALES // Vertrieb
  BACKOFFICE
  FULFILLMENT
  MARKETING
  EXECUTIVE // Geschäftsführung (GF/CEO/CFO)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         UserRole

  // Nur für Agentur-Mitarbeiter (AGENCY_ADMIN/AGENCY_STAFF) relevant - siehe
  // AgencyDepartment. Bestimmt den Hub im internen Portal (/dashboard/intern).
  department AgencyDepartment?

  // Cashflow Cockpit ist grundsätzlich nur für department=EXECUTIVE sichtbar -
  // dieser Schalter erlaubt der Geschäftsführung, es gezielt auch anderen
  // Mitarbeiter:innen freizugeben (z.B. Backoffice), ohne deren Abteilung zu ändern.
  hasCashflowAccess Boolean @default(false)

  // ---------------------------------------------------------------------
  // Personal (HR) - siehe /dashboard/intern/personal, Ersatz für Tellent HR.
  // Gilt für alle Agentur-Mitarbeiter (AGENCY_ADMIN + AGENCY_STAFF), nicht
  // für Kunden. Bewusst KEINE Zeiterfassung (Vertrauensarbeitszeit).
  // ---------------------------------------------------------------------
  managerId String?
  manager   User?   @relation("ManagerOf", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("ManagerOf")

  position          String? // Job-Titel, z.B. "Online Marketing Manager" - unabhängig von department/Gruppe
  location          String? // Standort, z.B. "Hamburg"
  birthday          DateTime?
  hireDate          DateTime? // "Unternehmensbeitritt"
  // Ehemalige Mitarbeiter werden nicht gelöscht (Personalakte/Verträge/
  // Abwesenheitshistorie bleiben erhalten), sondern hier markiert - analog
  // zu Organization.archivedAt.
  employmentEndedAt DateTime?

  // Set when the user is invited via activation link instead of a password;
  // cleared once they complete activation and set their own password.
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Persönliche Einstellung (nicht pro Kampagne): per E-Mail benachrichtigt
  // werden, wenn auf einer Kampagne mit Zugriff ein neuer Lead/Bewerber
  // eingeht. Greift nur, wenn zusätzlich Pipeline.notifyOnNewContact aktiv
  // ist - beide Schalter zusammen entscheiden, siehe notify-new-contact.ts.
  notifyOnNewContact Boolean @default(true)

  // Nur relevant für Agentur-Mitarbeiter, die als Account Manager oder
  // Buchhaltungs-/Backoffice-Ansprechpartner im Kunden-Hub eines Kunden
  // erscheinen: eigene Telefonnummer + persönlicher Calendly-Terminlink +
  // Profilbild. Selbst gepflegt unter Einstellungen -> Account.
  phone       String?
  calendlyUrl String?
  avatarUrl   String?

  // Plain-text signature, appended to every mail sent via a connected
  // EmailAccount (see sendEmailViaAccount) - set under Einstellungen ->
  // Postfach, next to the mailbox connection itself.
  signature String?

  // Set on every successful credentials login (src/auth.ts authorize
  // callback) - powers the "letzter Login" column on the Kunden-Log tab.
  lastLoginAt DateTime?

  pipelineAccess            PipelineAccess[]
  activities                Activity[]
  emailAccounts             EmailAccount[]
  enrollments               Enrollment[]
  auditLogs                 AuditLog[]
  offerInterests            OfferInterest[]
  automationRules           AutomationRule[]
  managedOrganizations      Organization[]             @relation("AccountManagerFor")
  backofficeContactForOrgs  Organization[]             @relation("BackofficeContactFor")
  connectedMetaLeadForms    MetaLeadFormConnection[]
  connectedSocialChannels   SocialChannel[]
  socialPostsResponsible    SocialPost[]
  connectedWhatsAppChannels WhatsAppChannel[]
  whatsAppTemplateSends     WhatsAppTemplateSend[]
  tasksCreated              Task[]                     @relation("TaskCreatedBy")
  tasksAssigned             Task[]                     @relation("TaskAssignedTo")
  partnerPointsTransactions PartnerPointsTransaction[]
  employeeDocuments         EmployeeDocument[]         @relation("EmployeeDocumentSubject")
  employeeDocumentsUploaded EmployeeDocument[]         @relation("EmployeeDocumentUploadedBy")
  absenceBalances           AbsenceBalance[]
  absenceRequests           AbsenceRequest[]           @relation("AbsenceRequestUser")
  absenceRequestsDecided    AbsenceRequest[]           @relation("AbsenceRequestDecidedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([managerId])
}

// Grants a CLIENT_STAFF user access to one pipeline (campaign).
// CLIENT_ADMIN / AGENCY_ADMIN implicitly see every pipeline in their org tree,
// so this table only needs rows for staff-level scoping.
model PipelineAccess {
  id         String   @id @default(cuid())
  userId     String
  pipelineId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, pipelineId])
  @@index([pipelineId])
}

// ---------------------------------------------------------------------------
// Pipelines / CRM & ATS core
// ---------------------------------------------------------------------------

enum PipelineKind {
  LEADS // Sales / CRM pipeline ("Mandatsakquise")
  APPLICANTS // Recruiting / ATS pipeline ("Recruiting")
}

// Admin-managed, named blueprint for a pipeline's initial stage list (e.g.
// "CRM", "ATS", or a client-specific custom workflow). Only used to seed a
// new Pipeline's Stage rows at creation time — editing a template afterwards
// does not retroactively change pipelines already created from it.
model StageTemplate {
  id     String @id @default(cuid())
  name   String
  stages Json // [{ name: string, order: number, color: string, isRejected?: boolean }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pipeline {
  id                   String       @id @default(cuid())
  name                 String
  kind                 PipelineKind
  active               Boolean      @default(true)
  showDuplicateWarning Boolean      @default(true)
  location             String? // Recruiting: which office/site this specific job posting is for

  // Kunden per E-Mail benachrichtigen, wenn auf dieser Kampagne ein neuer
  // Lead/Bewerber eingeht - default an. Wirkt zusammen mit dem persönlichen
  // Schalter User.notifyOnNewContact: es werden nur Nutzer mit Zugriff auf
  // diese Kampagne benachrichtigt, die ihrerseits nicht abbestellt haben.
  notifyOnNewContact Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stages                  Stage[]
  contacts                Contact[]
  access                  PipelineAccess[]
  webhookEndpoints        WebhookEndpoint[]
  metaLeadFormConnections MetaLeadFormConnection[]
  automationRules         AutomationRule[]
  socialPosts             SocialPost[]
  jobPosting              JobPosting?
  nurtureFunnels          NurtureFunnel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Vorbereitungs-Inhalte fürs Multiposting auf Stellenportale (Indeed,
// StepStone, XING etc.) - der Stellentitel ist bewusst NICHT hier
// gespeichert, sondern bleibt immer Pipeline.name, damit Kampagne und
// Stellenanzeige nie auseinanderlaufen. 1:1 zu einer APPLICANTS-Pipeline,
// wird lazy angelegt sobald die Agentur das Modul zum ersten Mal befüllt.
model JobPosting {
  id         String   @id @default(cuid())
  pipelineId String   @unique
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  heroImageUrl String?
  galleryUrls  String[] @default([])

  aboutUs String? // Über uns / über die Kanzlei
  tasks   String? // Aufgaben der Stelle
  profile String? // Dein Profil / Anforderungen

  benefitsList String[] @default([])

  contactName    String?
  contactEmail   String?
  applicationUrl String?

  // Arbeitgeber-Identität für die öffentliche Stellenanzeige-Seite
  // (/jobs/[pipelineId]) und deren JobPosting-Strukturdaten: hier steht
  // immer der Kunde (Mandant) als Employer, nie die Agentur - Google for
  // Jobs und (perspektivisch) Indeed lesen hiringOrganization aus genau
  // diesen Feldern. Fällt employerName leer, zeigt die Seite den
  // Organisationsnamen des Kunden als Fallback.
  employerName    String?
  employerLogoUrl String?
  employerWebsite String?

  // Strukturierte Adresse fürs JobPosting-Schema (jobLocation) - das freie
  // Pipeline.location-Textfeld reicht Google/Indeed dafür nicht.
  street     String?
  postalCode String?
  city       String?
  country    String? @default("DE")

  // schema.org EmploymentType-Wert (z.B. "FULL_TIME") - siehe
  // src/lib/job-schema.ts.
  employmentType String?   @default("FULL_TIME")
  validThrough   DateTime?

  // Steuert, ob /jobs/[pipelineId] öffentlich (200) oder 404 ausliefert.
  // publishedAt wird beim ersten Veröffentlichen einmalig gesetzt und
  // danach nicht mehr verändert, weil schema.org datePosted stabil bleiben
  // soll, auch wenn der Inhalt später bearbeitet wird.
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Katalog-Keys aus src/lib/job-portals.ts - rein informative Checkliste,
  // solange keine der Portal-APIs/-Feeds angebunden ist.
  targetPortals String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stage {
  id         String  @id @default(cuid())
  name       String
  order      Int
  color      String?
  isRejected Boolean @default(false)

  // Markiert die eine "Erfolgs"-Stufe der Kampagne (Eingestellt/Gewonnen) -
  // bewusst explizit statt aus der Sortierreihenfolge abgeleitet, da eine
  // nachträglich angehängte Ungeeignet-Stufe (oder eine eigene "Verloren"-
  // Stufe danach) sonst fälschlich als "letzte" Stufe erkannt würde. Löst
  // FinalStageDialog aus (Einstellungsdatum/Dealvolumen), siehe
  // src/lib/final-stage.ts. Höchstens eine Stufe pro Kampagne.
  isFinal Boolean @default(false)

  pipelineId String
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  contacts   Contact[]

  createdAt DateTime @default(now())

  @@index([pipelineId])
}

enum ContactSource {
  MANUAL
  WEBHOOK_GENERIC
  ZAPIER
  GOOGLE_ADS
  META_LEAD_ADS
  LINKEDIN_LEAD_GEN
  ONEPAGE
  PERSPEKTIVE
  ELEMENTOR
  TYPEFORM
  FUNNELCOCKPIT
  HEYFLOW
  MEETOVO
  AIDAFORM
  THRIVE
  MATELSO
}

// A Lead or an Applicant, depending on the pipeline's kind.
model Contact {
  id           String        @id @default(cuid())
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  location     String?
  rating       Int?          @db.SmallInt // 1-5 star qualification rating, null = not yet rated
  source       ContactSource @default(MANUAL)
  cvUrl        String? // Uploaded manually or filled from a webhook payload (e.g. Perspektive/OnePage CV upload link)
  // Raw/extra fields that don't map to a fixed column (form-specific answers, UTM data, ...)
  customFields Json?

  // B2B ("Mandatsakquise") only: set companyName to mark this lead as a
  // company rather than a private individual - the company name becomes the
  // primary display name, and additionalContacts holds other people at the
  // same company. Left null for B2C leads and all Recruiting contacts.
  companyName String?
  website     String? // manually set, or auto-derived from the email domain
  address     String?

  // Set when moved into an isRejected stage, cleared again on reactivation.
  // One of the fixed, kind-specific options in src/lib/rejection-reasons.ts -
  // lets the agency analyze per client why leads/applicants don't convert.
  rejectionReason String?

  // Talentpool: passt aktuell nicht, grundsätzlich aber interessant - wird
  // per Wiedervorlage (Task) automatisch nach einigen Monaten erneut vorgelegt.
  // Ein Kontakt gehört höchstens einem (benannten) Pool an.
  talentPoolId   String?
  talentPool     TalentPool? @relation(fields: [talentPoolId], references: [id], onDelete: SetNull)
  talentPoolNote String?

  // Nur bei Erreichen der jeweils letzten (nicht-abgelehnten) Stufe der
  // Kampagne per Pflichtfeld im Popup abgefragt und gesetzt - siehe
  // FinalStageDialog. startDate = Einstellungsdatum (Recruiting),
  // dealVolumeEur = Auftragswert in Euro (Mandatsakquise, "gewonnen").
  startDate     DateTime?
  dealVolumeEur Int?

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])

  activities         Activity[]
  emailMessages      EmailMessage[]
  additionalContacts AdditionalContact[]
  automationLogs     AutomationLog[]
  metaLeadDeliveries MetaLeadDelivery[]
  tasks              Task[]
  funnelEnrollments  FunnelEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineId])
  @@index([stageId])
  @@index([talentPoolId])
}

// Named group a contact can be placed into when they don't fit right now but
// are worth keeping - a client can create and name as many pools as they
// like (e.g. by role, by seniority). Org-scoped, not campaign-scoped, since
// a good candidate found via one campaign may fit a future one.
model TalentPool {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String

  contacts Contact[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// Extra people at the same B2B company (Contact.companyName set). Kept
// separate from Contact so a company lead can have several without
// overloading the single-person Contact columns.
model AdditionalContact {
  id    String  @id @default(cuid())
  name  String
  role  String?
  email String?
  phone String?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([contactId])
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  EMAIL_IN
  EMAIL_OUT
  CALL
  // Kommentar zwischen Kunde und Agentur an einem Kontakt - im Gegensatz zu
  // NOTE löst das Erstellen eine E-Mail-Benachrichtigung an die jeweils
  // andere Seite aus (siehe src/lib/actions/comments.ts).
  COMMENT
}

model Activity {
  id       String       @id @default(cuid())
  type     ActivityType
  content  String?
  metadata Json?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Lead ingestion
// ---------------------------------------------------------------------------

enum WebhookSource {
  GENERIC
  ZAPIER
  GOOGLE_ADS
  ONEPAGE
  PERSPEKTIVE
  META_LEAD_ADS
  LINKEDIN_LEAD_GEN
  ELEMENTOR
  TYPEFORM
  FUNNELCOCKPIT
  HEYFLOW
  MEETOVO
  AIDAFORM
  THRIVE
  MATELSO // Call-Tracking (Dynamic Number Insertion): Anrufer-Leads aus Google-Ads-Landingpages
}

// One inbound endpoint per pipeline+source; `token` is the unguessable
// path segment used in the public URL, field mapping controls how the
// arbitrary payload lands on Contact/customFields.
model WebhookEndpoint {
  id              String        @id @default(cuid())
  token           String        @unique @default(cuid())
  source          WebhookSource
  fieldMapping    Json? // e.g. { "firstName": "data.first_name", "email": "data.email" }
  // Recruiting, multi-location jobs sharing one funnel/webhook: maps a
  // location answer value (as it appears anywhere in the payload) to the
  // Pipeline id it should actually be filed under, e.g.
  // { "Hamburg": "clx...pipelineIdHH", "Berlin": "clx...pipelineIdB" }.
  // Falls back to this endpoint's own pipelineId when nothing matches.
  locationRouting Json?
  active          Boolean       @default(true)

  // Call-Tracking-Quellen (z.B. matelso): Anrufe unter dieser Dauer werden
  // nicht als Lead angelegt (Verwähler/Auflegen rausfiltern). Erwartet die
  // Anrufdauer in Sekunden unter dem fieldMapping-Schlüssel
  // "callDurationSeconds" (oder per Auto-Detect, siehe webhook-ingest.ts).
  minCallDurationSeconds Int?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([pipelineId])
}

// Raw log of every inbound webhook call, kept for debugging failed mappings.
model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  rawPayload    Json
  contactId     String?
  error         String?
  // Set instead of `error` when the payload was valid but deliberately not
  // turned into a Contact (e.g. a call below minCallDurationSeconds) - kept
  // separate from `error` so the UI can show it as informational, not a failure.
  skippedReason String?
  createdAt     DateTime        @default(now())

  @@index([endpointId])
}

// ---------------------------------------------------------------------------
// Meta (Facebook/Instagram) Lead Ads: echte OAuth-Direktintegration statt
// eines generischen Webhook-Tokens. Ein Agentur-Mitarbeiter verbindet eine
// Facebook-Seite + ein konkretes Instant-Formular mit genau einer Pipeline;
// neue Formular-Antworten kommen dann per Meta-Leadgen-Webhook
// (src/app/api/webhooks/meta/leadgen/route.ts) automatisch als Contact rein,
// ganz ohne Zapier/Make als Zwischenschritt.
// ---------------------------------------------------------------------------

model MetaLeadFormConnection {
  id                 String  @id @default(cuid())
  pageId             String
  pageName           String?
  formId             String
  formName           String?
  // Verschlüsselt wie EmailAccount.accessTokenEnc (src/lib/auth-encryption.ts).
  // Page Access Tokens aus einem Long-Lived User Token laufen praktisch nicht
  // ab, solange der Zugriff nicht entzogen wird - siehe lastError für den
  // Fall, dass Meta ihn dennoch irgendwann ablehnt (Graph-Fehlercode 190).
  pageAccessTokenEnc String

  // Wird auf false gesetzt, sobald Meta den Access Token ablehnt (Passwort
  // geändert, Zugriff in Facebook entzogen o.ä.) - die Kachel im
  // Lead-Quellen-Tab fordert dann zum erneuten Verbinden auf, statt weiter
  // stillschweigend Leads zu verlieren.
  active    Boolean @default(true)
  lastError String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  connectedByUserId String?
  connectedBy       User?   @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  deliveries MetaLeadDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, formId])
  @@index([organizationId])
  @@index([pipelineId])
  @@index([pageId])
}

// Idempotenz + Audit-Log für eingehende Meta-Leadgen-Webhook-Events: Metas
// eigene Zustellung wiederholt sich bei Fehlern/Timeouts, daher verhindert
// der Unique-Index auf (connectionId, leadgenId), dass derselbe Lead zweimal
// als Contact angelegt wird.
model MetaLeadDelivery {
  id           String                 @id @default(cuid())
  connectionId String
  connection   MetaLeadFormConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  leadgenId    String
  contactId    String?
  contact      Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  rawPayload   Json?
  error        String?
  createdAt    DateTime               @default(now())

  @@unique([connectionId, leadgenId])
  @@index([connectionId])
}

// ---------------------------------------------------------------------------
// Social Media Content: agency-run content hub + own publisher
// ---------------------------------------------------------------------------

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
}

// A connected Page/Business-Account/Organization the agency can publish to on
// behalf of a client - the "Lead-Quelle" equivalent for outbound content
// instead of inbound leads. Connected once per client per platform (not per
// campaign, a Page belongs to the client's brand as a whole), only by agency
// admins. Shape mirrors MetaLeadFormConnection.
model SocialChannel {
  id          String         @id @default(cuid())
  platform    SocialPlatform
  externalId  String // Facebook Page id / Instagram Business Account id / LinkedIn Organization URN
  displayName String

  // Verschlüsselt wie MetaLeadFormConnection.pageAccessTokenEnc.
  accessTokenEnc String
  tokenExpiresAt DateTime?

  // Wird auf false gesetzt, sobald die Plattform den Token ablehnt - die
  // Kanal-Kachel fordert dann zum erneuten Verbinden auf, statt Beiträge
  // stillschweigend nicht zu veröffentlichen.
  active    Boolean @default(true)
  lastError String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  connectedByUserId String?
  connectedBy       User?   @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  posts SocialPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, platform, externalId])
  @@index([organizationId])
}

// WhatsApp Business Platform (Cloud API) - fürs interne Marketing-Center, um
// von Meta genehmigte Vorlagen-Nachrichten an eine Empfängerliste zu
// verschicken. Setzt ein bei Meta verifiziertes Business-Konto plus eine
// registrierte WhatsApp-Business-Telefonnummer voraus (das kann die App
// selbst nicht herstellen, nur die anschließende OAuth-Verbindung dazu).
model WhatsAppChannel {
  id                 String @id @default(cuid())
  businessAccountId  String // WABA-ID
  phoneNumberId      String
  displayPhoneNumber String
  displayName        String

  // Verschlüsselt wie SocialChannel.accessTokenEnc.
  accessTokenEnc String
  active         Boolean @default(true)
  lastError      String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  connectedByUserId String?
  connectedBy       User?   @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  sends WhatsAppTemplateSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phoneNumberId])
  @@index([organizationId])
}

enum WhatsAppSendStatus {
  SENT
  FAILED
}

// Protokoll jedes einzelnen Versands (ein Empfänger = eine Zeile), inklusive
// Meta-Nachrichten-ID zum Nachverfolgen - kein Broadcast verschwindet
// stillschweigend "ins Leere".
model WhatsAppTemplateSend {
  id                String          @id @default(cuid())
  channelId         String
  channel           WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  templateName      String
  languageCode      String
  recipientPhone    String
  status            WhatsAppSendStatus
  externalMessageId String?
  error             String?

  sentByUserId String?
  sentBy       User?   @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([channelId])
}

enum SocialPostStatus {
  IDEA
  IN_PRODUCTION
  CLIENT_REVIEW
  CHANGES_REQUESTED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum SocialMediaType {
  IMAGE
  VIDEO
  CAROUSEL
}

// One social media post through its whole lifecycle: idea -> production ->
// client approval -> scheduled -> actually published by the platform adapter
// (src/lib/social/publish.ts). Replaces the SocialPilot planning workflow
// with one system the client also sees into (read-only calendar + approval).
model SocialPost {
  id        String           @id @default(cuid())
  platform  SocialPlatform
  caption   String
  mediaUrl  String? // single image/video (mediaType IMAGE|VIDEO)
  mediaUrls String[]         @default([]) // carousel images (mediaType CAROUSEL) - 2-10 images
  mediaType SocialMediaType?
  status    SocialPostStatus @default(IDEA)

  scheduledAt    DateTime?
  publishedAt    DateTime?
  publishedUrl   String?
  externalPostId String?
  publishError   String?

  // Vom Kunden bei "Änderung wünschen" hinterlassener Wunsch - für die
  // Agentur sichtbar, bis der Beitrag erneut zur Freigabe eingereicht wird.
  clientFeedback String?

  // An jeden Link in der Caption angehängt (utm_source/utm_medium werden aus
  // der Plattform abgeleitet, nur die Kampagne ist frei wählbar) - siehe
  // src/lib/social/utm.ts.
  utmCampaign String?

  // Von Meta abgerufene Leistungskennzahlen (src/lib/social/insights-sync.ts) -
  // aktueller Stand, keine Historie. null bis zum ersten Sync nach Veröffentlichung.
  impressions      Int?
  reach            Int?
  likeCount        Int?
  commentCount     Int?
  shareCount       Int?
  clickCount       Int?
  insightsSyncedAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  channelId String?
  channel   SocialChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  responsibleUserId String?
  responsible       User?   @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments SocialComment[]

  @@index([organizationId])
  @@index([status, scheduledAt])
}

// A comment on a published SocialPost, synced from the platform (webhook
// push for Meta, periodic poll as a fallback/for LinkedIn) - powers the
// Community Center inbox. One level of reply nesting via parentCommentId,
// matching what the platforms themselves support (Instagram in particular
// never nests deeper than one level).
model SocialComment {
  id         String     @id @default(cuid())
  externalId String // the platform's own comment id
  postId     String
  post       SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorName      String
  authorAvatarUrl String?
  message         String
  isHidden        Boolean @default(false)
  // True for a reply we posted through this tool (vs. an end-user's comment) -
  // lets the inbox visually distinguish "us" from "them" in a thread.
  isOwnReply      Boolean @default(false)

  parentCommentId String?
  parent          SocialComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         SocialComment[] @relation("CommentReplies")

  postedAt  DateTime // the platform's own comment timestamp
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, externalId])
  @@index([postId])
}

// ---------------------------------------------------------------------------
// Automatisierungen: reminder emails for stale leads/applicants
// ---------------------------------------------------------------------------

enum AutomationTrigger {
  NEW_LEAD // fires once, shortly after a contact is created
  UNPROCESSED_24H // fires once if no activity was logged within 24h of creation
  UNPROCESSED_72H // fires once if no activity was logged within 72h of creation
}

// One row per (pipeline, trigger) - a fixed set of reminder rules a campaign
// can turn on and assign a recipient to, evaluated by a periodic cron job.
// Sent "from" a fixed system address (see src/lib/email/resend.ts), not a
// per-rule sender, since delivery must work with no user session present.
model AutomationRule {
  id      String            @id @default(cuid())
  trigger AutomationTrigger
  active  Boolean           @default(false)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  recipientUserId String?
  recipientUser   User?   @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  logs AutomationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, trigger])
  @@index([pipelineId])
}

// Records that a rule already fired for a contact, so a reminder is sent at
// most once per contact per trigger even though the cron job re-scans
// everything on every run.
model AutomationLog {
  id     String         @id @default(cuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  sentAt DateTime @default(now())

  @@unique([ruleId, contactId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Wiedervorlage (Tasks)
// ---------------------------------------------------------------------------

// A follow-up reminder tied to a contact ("Wiedervorlage"). The daily cron
// (src/app/api/cron/daily/route.ts) emails assignedTo once dueAt has passed,
// tracked via reminderSentAt so it fires exactly once per task.
model Task {
  id          String    @id @default(cuid())
  title       String
  dueAt       DateTime
  completedAt DateTime?

  // If set, completing this task immediately creates the next occurrence
  // (new dueAt = old dueAt + N days) instead of the series just ending -
  // used for the Talentpool "erneut kontaktieren in 6 Monaten" reminder.
  repeatIntervalDays Int?
  reminderSentAt     DateTime?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdByUserId  String?
  createdBy        User?   @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedToUserId String?
  assignedTo       User?   @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([dueAt])
  @@index([assignedToUserId])
}

// ---------------------------------------------------------------------------
// Textbausteine (Vorlagen)
// ---------------------------------------------------------------------------

enum TemplateKind {
  NOTE
  EMAIL
}

// Reusable snippet for the Notiz-Formular oder E-Mail-Formular, owned by one
// organization (Agentur oder Kunde) so each side manages its own set.
model MessageTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kind    TemplateKind
  name    String
  subject String? // nur bei kind = EMAIL genutzt
  body    String

  // Automatischer Empfangsbestätigung an den Lead/Bewerber selbst, direkt bei
  // Eingang (Webhook/manuell angelegt) - höchstens eine EMAIL-Vorlage pro
  // Organisation und Kampagnentyp (der Unique-Index unten erzwingt das nur
  // für Zeilen mit gesetztem Wert, da Postgres NULL != NULL behandelt).
  // null = kein Automatikversand für diese Vorlage.
  defaultForKind PipelineKind?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, defaultForKind])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Email integration (per client staff member, not per lead)
// ---------------------------------------------------------------------------

enum EmailProvider {
  GOOGLE
  MICROSOFT
}

model EmailAccount {
  id       String        @id @default(cuid())
  provider EmailProvider
  email    String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tokens are encrypted at rest by the application layer before being stored here.
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime

  messages         EmailMessage[]
  nurtureFunnels   NurtureFunnel[]
  marketingFunnels MarketingFunnel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, email])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id                String         @id @default(cuid())
  direction         EmailDirection
  subject           String?
  bodyText          String?
  bodyHtml          String?
  fromAddress       String
  toAddress         String
  providerMessageId String

  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  sentAt    DateTime
  createdAt DateTime @default(now())

  @@unique([emailAccountId, providerMessageId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Schulung / LMS
// ---------------------------------------------------------------------------

enum CourseCategory {
  ONBOARDING // Required platform onboarding for new customers/staff
  TRAINING // General knowledge-transfer courses
}

// Legt fest, wo ein Kurs überhaupt auftauchen kann: im Kunden-Schulungsbereich
// (zugewiesen per CourseAssignment/Organization) oder im internen Portal
// (zugewiesen per CourseDepartmentAssignment/AgencyDepartment) - nie in
// beiden zugleich, damit Mitarbeiter-Schulungen nie im Kundenportal auftauchen.
enum CourseAudience {
  CLIENT
  INTERNAL
}

// Courses are authored by the agency and only visible to clients they've been
// explicitly assigned to via CourseAssignment (opt-in, no default visibility).
model Course {
  id           String         @id @default(cuid())
  title        String
  description  String?
  category     CourseCategory
  audience     CourseAudience @default(CLIENT)
  thumbnailUrl String?
  published    Boolean        @default(false)

  modules               Module[]
  enrollments           Enrollment[]
  assignments           CourseAssignment[]
  departmentAssignments CourseDepartmentAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Grants a client organization visibility into a course (e.g. "Recruiting"
// vs. "Kundengewinnung" depending on which service the client booked).
model CourseAssignment {
  id             String       @id @default(cuid())
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([courseId, organizationId])
  @@index([organizationId])
}

// Wie CourseAssignment, aber für audience=INTERNAL Kurse: Zielgruppe ist eine
// Abteilung (AgencyDepartment) statt einer Kunden-Organisation, da es nur die
// eine Agentur-Organisation gibt und Vertrieb/Backoffice/... sich darin nicht
// über organizationId unterscheiden lassen.
model CourseDepartmentAssignment {
  id         String           @id @default(cuid())
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department AgencyDepartment

  createdAt DateTime @default(now())

  @@unique([courseId, department])
  @@index([department])
}

// Grouping level between Course and Lesson (e.g. "Modul 1 - Theoretische
// Grundlagen"), mirroring the LearningSuite platform this was modeled after.
model Module {
  id           String  @id @default(cuid())
  title        String
  description  String?
  order        Int
  thumbnailUrl String?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id              String  @id @default(cuid())
  title           String
  description     String?
  order           Int
  videoUrl        String? // Vercel Blob URL (uploaded video)
  thumbnailUrl    String?
  pdfUrl          String? // Link to an external PDF
  notionUrl       String? // Link to an external Notion doc
  durationSeconds Int?
  content         Json? // Ordered array of LessonBlock (see src/lib/lesson-blocks.ts) - the page-builder content below the video

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress LessonProgress[]

  @@index([moduleId])
}

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  progress  LessonProgress[]
  createdAt DateTime         @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime?

  @@unique([enrollmentId, lessonId])
}

// ---------------------------------------------------------------------------
// Kunden-Hub: Angebote / Upsells
// ---------------------------------------------------------------------------

// An upsell/offer shown in every client's Kunden-Hub, unless the client
// already has the matching productTag in Organization.bookedProductTags.
model Offer {
  id          String  @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  ctaLabel    String  @default("Interesse")
  active      Boolean @default(true)

  // Kleines Schlagwort über dem Titel, z.B. "Neu" oder "Beliebt".
  badge String?

  // Stichpunktartige Vorteile, in der angegebenen Reihenfolge angezeigt.
  highlights String[] @default([])

  // Weitere Bilder/Mockups zusätzlich zum imageUrl-Titelbild.
  galleryUrls String[] @default([])

  // Freier Tag (z.B. "webseite", "social_media") - matched gegen
  // Organization.bookedProductTags, um das Angebot für Kunden auszublenden,
  // die es bereits gebucht haben. Leer = wird allen Kunden gezeigt.
  productTag String?

  interests OfferInterest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (id = "default") for platform-wide toggles the agency admin
// controls themselves, independent of deploys - e.g. whether the Angebote
// section is already live for clients.
model PlatformSettings {
  id                   String  @id @default("default")
  offersSectionEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// E-Mail-Center: agency-editable content for automated system emails
// ---------------------------------------------------------------------------

enum SystemEmailType {
  PASSWORD_RESET
  PORTAL_INVITE
  NEW_LEAD_NOTIFICATION
  NEW_APPLICANT_NOTIFICATION
  ABSENCE_REQUEST_SUBMITTED
  ABSENCE_REQUEST_DECIDED
}

// Editable subject/heading/body/button text for an automated email (see
// src/lib/email/system-email-defaults.ts for the shipped defaults, used
// whenever no row exists yet for a type). The visual design (logo, colors,
// button) itself stays fixed in src/lib/email/template.ts.
model SystemEmailTemplate {
  id         String          @id @default(cuid())
  type       SystemEmailType @unique
  subject    String
  heading    String
  body       String
  ctaLabel   String
  footerNote String?

  updatedAt DateTime @updatedAt
}

// Recorded whenever a client user clicks the CTA on an offer, so the agency
// gets notified instead of a payment flow running automatically.
model OfferInterest {
  id      String  @id @default(cuid())
  offerId String
  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  note    String?

  createdAt DateTime @default(now())

  @@index([offerId])
}

// ---------------------------------------------------------------------------
// Seiten-Layout: agency-editable order/visibility of the fixed, data-driven
// sections on client-facing dashboard pages (see src/lib/page-layout.ts for
// the block catalog). Global across all clients, not per-organization.
// ---------------------------------------------------------------------------

enum DashboardPage {
  OVERVIEW
  HUB
  // Ein Wert je AgencyDepartment - das "Mein Dashboard" jedes Mitarbeiters im
  // internen Portal, siehe getDepartmentHubPage().
  SALES_HUB
  BACKOFFICE_HUB
  FULFILLMENT_HUB
  MARKETING_HUB
  EXECUTIVE_HUB
}

// ---------------------------------------------------------------------------
// Internes Portal (Intranet): Abteilungs-Hubs für Nicht-Fulfillment-
// Mitarbeiter (Vertrieb, Backoffice, ...), siehe AgencyDepartment. Ersetzt für
// diese Zielgruppe den Kunden-Hub - Kunden haben hierauf keinen Zugriff.
// ---------------------------------------------------------------------------

// Frei pflegbare Links/Dateien je Abteilung (z.B. Vertriebsunterlagen,
// Pitch-Deck) - der Assets/Ressourcen-Block im Abteilungs-Hub.
model DepartmentResourceLink {
  id         String           @id @default(cuid())
  department AgencyDepartment
  label      String
  url        String
  order      Int              @default(0)

  createdAt DateTime @default(now())

  @@index([department])
}

model PageLayoutBlock {
  id       String        @id @default(cuid())
  page     DashboardPage
  blockKey String
  order    Int
  enabled  Boolean       @default(true)

  updatedAt DateTime @updatedAt

  @@unique([page, blockKey])
  @@index([page])
}

// ---------------------------------------------------------------------------
// DSGVO / compliance
// ---------------------------------------------------------------------------

model AuditLog {
  id         String @id @default(cuid())
  action     String // e.g. "contact.viewed", "contact.updated", "user.invited"
  entityType String
  entityId   String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// E-Mail-Marketing (Nurture-Funnels für Mandatsakquise-Leads)
// ---------------------------------------------------------------------------

enum FunnelTriggerType {
  MANUAL // Leads werden von Agentur/Kunde gezielt ausgewählt und eingeschrieben
  ON_NEW_LEAD // jeder neue Lead dieser Kampagne wird automatisch eingeschrieben
  ON_INACTIVITY // Leads werden nach inactivityDays Tagen ohne Aktivität automatisch eingeschrieben
}

enum FunnelEnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED // manuell entfernt, oder automatisch gestoppt weil der Lead eine Erfolgs-/Ablehnungsstufe erreicht hat
}

// Ein Nurture-Funnel (Willkommens-/Aufwärm-Sequenz) für eine Mandatsakquise-
// Kampagne (Pipeline.kind == LEADS). Versendet wird über das verbundene
// Postfach (EmailAccount) eines Mitarbeiters des Kunden - siehe
// src/lib/mailbox/send.ts - damit Antworten direkt im echten Postfach des
// Kunden landen, nicht über die System-Absenderadresse.
model NurtureFunnel {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(false)

  triggerType    FunnelTriggerType @default(MANUAL)
  inactivityDays Int? // nur relevant bei triggerType = ON_INACTIVITY

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  senderAccountId String?
  senderAccount   EmailAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  steps       FunnelStep[]
  enrollments FunnelEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineId])
}

// Eine E-Mail innerhalb eines Funnels. delayDays ist die Wartezeit NACH der
// Einschreibung (order 1) bzw. nach dem Versand des vorherigen Schritts
// (order > 1) - modelliert die "Warten auf X Tage"-Knoten aus dem Referenz-
// Flow implizit über den nächsten Schritt, statt als eigene Entität.
model FunnelStep {
  id        String @id @default(cuid())
  order     Int
  delayDays Int    @default(0)

  subject   String
  preheader String?
  // Reiner Text mit {{firstName}}/{{lastName}}/{{companyName}}-Platzhaltern
  // und optionalen [Linktext](https://...)-Links, die beim Versand in
  // klick-getrackte Links umgewandelt werden - bewusst kein HTML-Editor,
  // damit die Mail wie eine echte persönliche Nachricht aus dem Postfach
  // des Kunden wirkt statt wie ein Marketing-Newsletter.
  bodyText  String
  ctaLabel  String?
  ctaUrl    String?

  funnelId String
  funnel   NurtureFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  sends FunnelStepSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funnelId, order])
}

// Ein Lead in einem Funnel. nextSendAt ist der Cursor, den der Funnel-Cron
// abfragt; currentStepOrder = 0 bedeutet "noch keine E-Mail verschickt".
model FunnelEnrollment {
  id     String                 @id @default(cuid())
  status FunnelEnrollmentStatus @default(ACTIVE)

  funnelId  String
  funnel    NurtureFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  currentStepOrder Int       @default(0)
  nextSendAt       DateTime?

  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sends FunnelStepSend[]

  @@unique([funnelId, contactId])
  @@index([funnelId])
  @@index([nextSendAt])
}

// Eine tatsächlich versendete E-Mail eines Schritts - trackingToken
// identifiziert die Zeile im Öffnungs-Pixel bzw. Klick-Redirect (siehe
// src/app/api/track/*), ohne die interne ID preiszugeben.
model FunnelStepSend {
  id            String @id @default(cuid())
  trackingToken String @unique @default(cuid())

  enrollmentId String
  enrollment   FunnelEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         FunnelStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  sentAt     DateTime  @default(now())
  openedAt   DateTime?
  openCount  Int       @default(0)
  clickedAt  DateTime?
  clickCount Int       @default(0)

  @@index([stepId])
  @@index([enrollmentId])
}

// ---------------------------------------------------------------------------
// Internes Marketing-Center: eigenständiges E-Mail-Marketing-Tool für die
// Agentur selbst (wie ActiveCampaign/KlickTipp) - bewusst komplett getrennt
// von Pipeline/Contact/NurtureFunnel (dem Kunden-CRM-Feature), damit sich
// Interessenten, die über eigene Ads/Landingpages eintragen, nicht mit
// Kunden-Kampagnen vermischen und "Internes Portal" nie ins Kunden-CRM
// springt. Kein Double-Opt-in: ein Kontakt ist ab Eintrag sofort aktiv.
// ---------------------------------------------------------------------------

model MarketingTag {
  id             String       @id @default(cuid())
  name           String
  color          String       @default("blue") // Tailwind-Farbtoken, wie AbsenceType.color
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscribers      MarketingSubscriberTag[]
  listWebhooks     MarketingListWebhook[]
  triggeredFunnels MarketingFunnel[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum MarketingSubscriberStatus {
  ACTIVE
  SUPPRESSED // hat z.B. einen Calendly-Termin gebucht - raus aus allen aktiven Funnels, bekommt keine weiteren Mails
}

// Ein E-Mail-Abonnent der Agentur selbst (potenzieller Kunde/Bewerber, über
// eine Ad/Landingpage eingetragen) - unabhängig von Contact (Kunden-CRM).
model MarketingSubscriber {
  id             String       @id @default(cuid())
  email          String
  firstName      String?
  lastName       String?
  phone          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status           MarketingSubscriberStatus @default(ACTIVE)
  suppressedAt     DateTime?
  suppressedReason String? // z.B. "calendly_booking"

  // Nach erstem erfolgreichen Sync gesetzt (Close.io-Lead-ID) - siehe
  // src/lib/close/client.ts. Bleibt null, solange kein passender Lead
  // gefunden wurde oder CLOSE_API_KEY nicht konfiguriert ist.
  closeLeadId String?

  tags        MarketingSubscriberTag[]
  enrollments MarketingEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}

model MarketingSubscriberTag {
  id           String              @id @default(cuid())
  subscriberId String
  subscriber   MarketingSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tagId        String
  tag          MarketingTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([subscriberId, tagId])
  @@index([tagId])
}

// Ein Webhook pro Tag - das externe Landingpage-/Formular-Tool ruft diese URL
// beim Absenden auf. Legt den Subscriber an (oder reaktiviert ihn) und hängt
// automatisch den Tag an, was wiederum verknüpfte MarketingFunnel auslöst.
model MarketingListWebhook {
  id             String       @id @default(cuid())
  token          String       @unique @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tagId          String
  tag            MarketingTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// Ein E-Mail-Funnel, ausgelöst durch das Setzen eines Tags (statt durch
// Zugehörigkeit zu einer Kampagne/Pipeline wie bei NurtureFunnel).
model MarketingFunnel {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // null = nur manuell einschreibbar, kein automatischer Trigger.
  triggerTagId String?
  triggerTag   MarketingTag? @relation(fields: [triggerTagId], references: [id], onDelete: SetNull)

  senderAccountId String?
  senderAccount   EmailAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  steps       MarketingFunnelStep[]
  enrollments MarketingEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([triggerTagId])
}

model MarketingFunnelStep {
  id        String @id @default(cuid())
  order     Int
  delayDays Int    @default(0)

  subject   String
  preheader String?
  bodyText  String
  ctaLabel  String?
  ctaUrl    String?

  funnelId String
  funnel   MarketingFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  sends MarketingFunnelSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funnelId, order])
}

// Ein Subscriber in einem Funnel - Semantik identisch zu FunnelEnrollment,
// nur auf MarketingSubscriber statt Contact bezogen.
model MarketingEnrollment {
  id     String                 @id @default(cuid())
  status FunnelEnrollmentStatus @default(ACTIVE)

  funnelId     String
  funnel       MarketingFunnel     @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   MarketingSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  currentStepOrder Int       @default(0)
  nextSendAt       DateTime?

  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sends MarketingFunnelSend[]

  @@unique([funnelId, subscriberId])
  @@index([funnelId])
  @@index([nextSendAt])
}

model MarketingFunnelSend {
  id            String @id @default(cuid())
  trackingToken String @unique @default(cuid())

  enrollmentId String
  enrollment   MarketingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         MarketingFunnelStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  sentAt     DateTime  @default(now())
  openedAt   DateTime?
  openCount  Int       @default(0)
  clickedAt  DateTime?
  clickCount Int       @default(0)

  @@index([stepId])
  @@index([enrollmentId])
}

// ---------------------------------------------------------------------------
// Cashflow Cockpit (nur intern, Geschäftsführung) - exakter Nachbau der
// geteilten Google-Sheet-Vorlage ("Cashflow Cockpit 2026"), bewusst OHNE
// Close.io: Cash-In basiert auf tatsächlich gestellten/geplanten Rechnungen
// (live aus EasyBill, siehe src/lib/easybill/client.ts - nicht gespiegelt),
// Cash-Out auf dem tatsächlichen Bankabgang. Cash-Out wird hier als
// Transaktions-Ledger gepflegt (eine Zeile = eine Buchung, wie im
// "🔥 Cash-Out"-Tab der Vorlage), nicht als Monats-Aggregat.
// ---------------------------------------------------------------------------

enum CashflowCostCategory {
  PERSONNEL // Mitarbeiter & Freelancer
  MARKETING
  INFRASTRUCTURE // Infrastruktur & Software
  VARIABLE // Variable Kosten
  AD_BUDGET // Werbebudget
}

model CashflowCostEntry {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactionDate DateTime // Datum des Bankabgangs
  counterparty   String // Gegenpartei laut Kontoauszug
  category       CashflowCostCategory
  amountNet      Float
  taxRatePercent Float                @default(19) // 0 / 7 / 19 %
  note           String?

  // Woher die Buchung stammt (z.B. "Volksbank HH", "Amex") - wichtig, weil
  // eine Amex-Kartenabrechnung als Sammelbuchung im Bankkonto-Export auftaucht,
  // aber die Einzelbuchungen separat aus einem Amex-CSV-Export importiert
  // werden - ohne dieses Feld würde es zur Doppelbuchung kommen.
  bankSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, transactionDate])
}

// ---------------------------------------------------------------------------
// Partnerprogramm (Prämien-Punkte für Kunden)
// ---------------------------------------------------------------------------

enum PartnerTransactionKind {
  EARNED // Punkte für eine erledigte PartnerAction gutgeschrieben (Agentur bestätigt manuell)
  REDEEMED // Punkte gegen eine PartnerReward eingelöst (Kunde selbst, negative Punktzahl)
  ADJUSTMENT // manuelle Korrektur durch die Agentur, ohne Bezug zu Action/Reward
}

// Katalog-Eintrag "Punkte sammeln" - global, gilt für alle Kunden. Punkte
// werden nicht automatisch erkannt (z.B. Google-Bewertung lässt sich nicht
// zuverlässig einem Kunden zuordnen), sondern von der Agentur nach Prüfung
// manuell gutgeschrieben - siehe PartnerPointsTransaction.
model PartnerAction {
  id          String  @id @default(cuid())
  title       String
  description String?
  ctaLabel    String  @default("Jetzt starten")
  ctaUrl      String?
  points      Int     @default(1)
  order       Int     @default(0)
  active      Boolean @default(true)

  transactions PartnerPointsTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Katalog-Eintrag "Punkte einlösen" - global, gilt für alle Kunden.
model PartnerReward {
  id          String  @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  ctaLabel    String  @default("Prämien-Punkte einlösen")
  pointsCost  Int
  order       Int     @default(0)
  active      Boolean @default(true)

  transactions PartnerPointsTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Ledger-Zeile pro Kunde - der Punktestand ergibt sich als SUM(points) über
// alle Zeilen eines Kunden, statt einen mutable Zähler zu pflegen (gleiche
// Begründung wie bei Activity/AuditLog: vollständige, nachvollziehbare
// Historie statt nur eines Endstands).
model PartnerPointsTransaction {
  id     String                 @id @default(cuid())
  kind   PartnerTransactionKind
  points Int // vorzeichenbehaftet: positiv bei EARNED, negativ bei REDEEMED, beides möglich bei ADJUSTMENT

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  actionId String?
  action   PartnerAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  rewardId String?
  reward   PartnerReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  note String?

  // Bei EARNED/ADJUSTMENT der Agentur-Mitarbeiter, der gutgeschrieben hat;
  // bei REDEEMED der Kunde, der eingelöst hat.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Personal (HR) - /dashboard/intern/personal, Ersatz für Tellent HR.
// Gilt für alle Agentur-Mitarbeiter, siehe User.managerId/position/location/
// birthday/hireDate/employmentEndedAt. Bewusst KEINE Zeiterfassung.
// ---------------------------------------------------------------------------

enum EmployeeDocumentCategory {
  CONTRACT // Verträge (Arbeitsvertrag, Nachträge)
  CERTIFICATE // Zertifikate
  OTHER // Andere Dokumente
}

// Digitale Personalakte - ein Dokument (i.d.R. hochgeladenes PDF) je Zeile,
// mehrere pro Mitarbeiter und Kategorie möglich (z.B. Arbeitsvertrag +
// mehrere Nachträge), analog zu Tellent HR.
model EmployeeDocument {
  id           String                   @id @default(cuid())
  userId       String
  user         User                     @relation("EmployeeDocumentSubject", fields: [userId], references: [id], onDelete: Cascade)
  category     EmployeeDocumentCategory
  title        String
  fileUrl      String
  description  String?
  documentDate DateTime?

  uploadedByUserId String?
  uploadedBy       User?   @relation("EmployeeDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum AbsenceAllowanceType {
  LIMITED // konfigurierbares Jahres-Kontingent (z.B. Urlaub) - siehe AbsenceBalance
  UNLIMITED // kein Kontingent (z.B. Krank, Homeoffice, Betriebsurlaub, Unbezahlter Urlaub)
}

// Konfigurierbare Abwesenheitsarten (von AGENCY_ADMIN gepflegt) - Vorbelegung
// entspricht der Tellent-HR-Standardliste (Urlaub/Krank/Homeoffice/
// Betriebsurlaub/Unbezahlter Urlaub), siehe seed/defaults.
model AbsenceType {
  id                String               @id @default(cuid())
  name              String
  icon              String // Lucide-Icon-Name fürs UI
  color             String // Tailwind-Farbtoken fürs UI (z.B. "blue")
  allowanceType     AbsenceAllowanceType @default(UNLIMITED)
  defaultAnnualDays Int? // nur bei LIMITED: Default-Kontingent für neue Balances
  weeklyCapDays     Int? // z.B. Homeoffice "bis zu 2 Tage pro Woche"
  requiresApproval  Boolean              @default(true)
  order             Int                  @default(0)
  archivedAt        DateTime?

  balances AbsenceBalance[]
  requests AbsenceRequest[]

  createdAt DateTime @default(now())

  @@index([order])
}

// "Konten": Jahres-Kontingent eines Mitarbeiters für eine LIMITED-Abwesenheitsart.
// "Verbraucht" wird nicht gespeichert, sondern live aus genehmigten
// AbsenceRequest-Tagen dieses Jahres berechnet (siehe getAbsenceBalances).
model AbsenceBalance {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  absenceTypeId String
  absenceType   AbsenceType @relation(fields: [absenceTypeId], references: [id], onDelete: Cascade)
  year          Int
  totalDays     Int

  @@unique([userId, absenceTypeId, year])
  @@index([userId])
}

enum AbsenceRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

// "Anträge" - ein Mitarbeiter beantragt eine Abwesenheit, genehmigt wird von
// AGENCY_ADMIN oder einem Manager in der Kette über ihm (siehe
// src/lib/hr-access.ts#isInManagerChainOf).
model AbsenceRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("AbsenceRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  absenceTypeId String
  absenceType   AbsenceType @relation(fields: [absenceTypeId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  days          Int
  note          String?

  status AbsenceRequestStatus @default(PENDING)

  decidedByUserId String?
  decidedBy       User?     @relation("AbsenceRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}
