# Postgres connection string (Neon/Supabase in production, local Postgres in dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanzlei_dev?schema=public"

# Auth.js session signing secret - generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# AES-256 key used to encrypt stored mailbox OAuth tokens - generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Google OAuth (Gmail mailbox connection for client staff, not for platform login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (Microsoft 365 mailbox connection for client staff)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Meta (Facebook/Instagram) OAuth - lets an agency admin connect a Facebook
# Page + Lead Ads Instant Form directly to a campaign under "Lead-Quellen",
# no Zapier/Make needed. Create a Meta app at developers.facebook.com, add
# the "Facebook Login for Business" + "Webhooks" products, and request App
# Review for the pages_show_list, pages_manage_metadata,
# pages_read_engagement and leads_retrieval permissions (requires Business
# verification). In the app's Webhooks settings, subscribe the "Page"
# object to the "leadgen" field with callback URL
# https://<your-domain>/api/webhooks/meta/leadgen and the verify token below.
META_APP_ID=""
META_APP_SECRET=""
# Freely chosen string, entered as the "Verify Token" in the Meta app's
# Webhooks setup above - generate with: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=""

# Vercel Blob storage token (course video uploads)
BLOB_READ_WRITE_TOKEN=""

# Resend (transactional email) - used only for the Automatisierungen reminder
# emails, which fire from a cron job with no user session and therefore can't
# use a staff member's connected mailbox. Needs a verified sending domain.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="automatisierung@kanzlei-brands.de"

# Shared secret checked against the Authorization header on
# /api/cron/automations, so only Vercel Cron (configured in vercel.json) can
# trigger it - generate with: openssl rand -base64 32
CRON_SECRET=""

# Slack Incoming Webhook (https://api.slack.com/messaging/webhooks) - used to
# notify the account manager when a client requests additional campaign
# quota. Create one under a Slack app's "Incoming Webhooks" feature for the
# channel you want notifications in.
SLACK_WEBHOOK_URL=""

# Shared secret in the URL path of /api/integrations/airtable-clients/[token],
# called by an Airtable Automation when a new record is created in the
# "Kunden" table, so a new client is created here automatically -
# generate with: openssl rand -base64 32
AIRTABLE_CLIENT_SYNC_TOKEN=""

# Pixabay API key (free) - powers the "Stock-Fotos" search in the course/
# module/lesson thumbnail generator. Get one at https://pixabay.com/api/docs/
# (free account, no cost, generous rate limit). Without it the stock-photo
# search shows a friendly error but manual thumbnail upload still works.
PIXABAY_API_KEY=""

# LinkedIn OAuth (Social Media Content publisher) - see src/lib/linkedin/client.ts.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Anthropic API key - powers the KI-Assistent (generate/rewrite/shorten/
# lengthen/tone/translate/hashtags) in the Social Media Content post editor.
# Get one at https://console.anthropic.com/settings/keys. Without it the
# assistant shows a friendly error but the rest of the post editor still works.
ANTHROPIC_API_KEY=""

# Close.io API key (close.com > Settings > API Keys) - powers three things:
# 1) the internal E-Mail-Marketing tool's Notiz-Sync on jedem Funnel-Versand
#    (src/lib/close/client.ts, syncFunnelSendToClose)
# 2) das Cashflow Cockpit's live Cash-In (gewonnene Opportunities je Monat)
# 3) das Sales Cockpit's live Anrufe/Abschlüsse/Volumen je Vertriebler
# Without it all three show a friendly "nicht verbunden" hint and 0-values -
# nothing crashes.
CLOSE_API_KEY=""

# Calendly Webhook Signing Key (Calendly > Integrations > Webhooks, shown
# when creating a subscription to /api/webhooks/calendly) - verifies the
# HMAC-SHA256 signature so a Calendly-Terminbuchung can suppress the
# matching Kontakt aus der internen E-Mail-Marketing-Liste (Fallout-Szenario,
# see src/app/api/webhooks/calendly/route.ts). Without it the endpoint
# rejects every request (401) instead of silently trusting unsigned payloads.
CALENDLY_WEBHOOK_SIGNING_KEY=""
