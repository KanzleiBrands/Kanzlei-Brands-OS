# Postgres connection string (Neon/Supabase in production, local Postgres in dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanzlei_dev?schema=public"

# Auth.js session signing secret - generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# AES-256 key used to encrypt stored mailbox OAuth tokens - generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Google OAuth (Gmail mailbox connection for client staff, not for platform login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (Microsoft 365 mailbox connection for client staff)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Meta (Facebook/Instagram) OAuth - lets an agency admin connect a Facebook
# Page + Lead Ads Instant Form directly to a campaign under "Lead-Quellen",
# no Zapier/Make needed. Create a Meta app at developers.facebook.com, add
# the "Facebook Login for Business" + "Webhooks" products, and request App
# Review for the pages_show_list, pages_manage_metadata,
# pages_read_engagement and leads_retrieval permissions (requires Business
# verification). In the app's Webhooks settings, subscribe the "Page"
# object to the "leadgen" field with callback URL
# https://<your-domain>/api/webhooks/meta/leadgen and the verify token below.
META_APP_ID=""
META_APP_SECRET=""
# Freely chosen string, entered as the "Verify Token" in the Meta app's
# Webhooks setup above - generate with: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=""

# Vercel Blob storage token (course video uploads)
BLOB_READ_WRITE_TOKEN=""

# Resend (transactional email) - used only for the Automatisierungen reminder
# emails, which fire from a cron job with no user session and therefore can't
# use a staff member's connected mailbox. Needs a verified sending domain.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="automatisierung@kanzlei-brands.de"

# Shared secret checked against the Authorization header on
# /api/cron/automations, so only Vercel Cron (configured in vercel.json) can
# trigger it - generate with: openssl rand -base64 32
CRON_SECRET=""

# Slack Incoming Webhook (https://api.slack.com/messaging/webhooks) - used to
# notify the account manager when a client requests additional campaign
# quota. Create one under a Slack app's "Incoming Webhooks" feature for the
# channel you want notifications in.
SLACK_WEBHOOK_URL=""

# Shared secret in the URL path of /api/integrations/airtable-clients/[token],
# called by an Airtable Automation when a new record is created in the
# "Kunden" table, so a new client is created here automatically -
# generate with: openssl rand -base64 32
AIRTABLE_CLIENT_SYNC_TOKEN=""

# Pixabay API key (free) - powers the "Stock-Fotos" search in the course/
# module/lesson thumbnail generator. Get one at https://pixabay.com/api/docs/
# (free account, no cost, generous rate limit). Without it the stock-photo
# search shows a friendly error but manual thumbnail upload still works.
PIXABAY_API_KEY=""

# LinkedIn OAuth (Social Media Content publisher) - see src/lib/linkedin/client.ts.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Anthropic API key - powers the KI-Assistent (generate/rewrite/shorten/
# lengthen/tone/translate/hashtags) in the Social Media Content post editor.
# Get one at https://console.anthropic.com/settings/keys. Without it the
# assistant shows a friendly error but the rest of the post editor still works.
ANTHROPIC_API_KEY=""

# Close.io API key (close.com > Settings > API Keys) - powers two things:
# 1) the internal E-Mail-Marketing tool's Notiz-Sync on jedem Funnel-Versand
#    (src/lib/close/client.ts, syncFunnelSendToClose)
# 2) das Sales Cockpit's live Opener/Setter/Closer-Kennzahlen aus Close
#    Custom Activities (1.0 Outbound Call / 1.2 Quali-Erstgespräch /
#    1.3 Sales Call / 2.3 After Sales Formular) - bewusst NICHT das
#    Cashflow Cockpit, das basiert auf tatsächlichem Cashflow (EasyBill +
#    Bankkonto), nicht auf Close-Auftragsvolumen.
# Without it both show a friendly "nicht verbunden" hint and 0-values -
# nothing crashes.
CLOSE_API_KEY=""

# EasyBill API key (easybill.de > Profil > Profil & Einstellungen > API Key
# > "Neuen Schlüssel generieren", dann oben rechts "Speichern" nicht
# vergessen) - powers das Cashflow Cockpit's live Cash-In: tatsächlich
# gestellte/geplante Rechnungen (src/lib/easybill/client.ts) inkl. Forecast
# aus laufenden wiederkehrenden Rechnungsvorlagen. Ohne Key zeigt das
# Cockpit einen "nicht verbunden"-Hinweis und 0-Werte statt zu crashen.
EASYBILL_API_KEY=""

# Calendly Personal Access Token (calendly.com > Integrationen und Apps >
# Ihr persönlicher Zugriffstoken > "Token erstellen", Scopes egal solange
# webhooks:read/webhooks:write dabei sind) - wird NUR einmalig gebraucht, um
# über den "Calendly-Webhook automatisch einrichten"-Button im
# Integrationen-Reiter das Organization-Webhook-Abo per API anzulegen (statt
# es manuell im Calendly-UI zu tun). Getrennt vom Signing-Key unten.
CALENDLY_API_TOKEN=""

# Calendly Webhook Signing Key - verifiziert die HMAC-SHA256-Signatur
# eingehender Events auf /api/webhooks/calendly (Terminbuchungen ->
# E-Mail-Marketing-Suppression + Candidate-Journey-Meilensteine). Wird NICHT
# manuell in Calendly angelegt, sondern automatisch generiert und einmalig
# angezeigt, wenn der Button oben (mit gesetztem CALENDLY_API_TOKEN) das
# Webhook-Abo anlegt - diesen angezeigten Wert hier eintragen. Ohne ihn
# lehnt der Endpoint jede Anfrage ab (401), statt unsignierte Payloads
# blind zu vertrauen.
CALENDLY_WEBHOOK_SIGNING_KEY=""

# Kampagnen-Reiter (inhouse Attributionstool, Moneyboard-Ersatz): Close.io-
# Sync + Candidate Journey laufen automatisch per Cron (CLOSE_API_KEY oben
# genügt dafür). Werbekosten laufen automatisch, SOBALD die folgenden
# Zugänge gesetzt sind (siehe /dashboard/intern/marketing/campaigns für den
# Live-Status je Plattform) - ohne sie zeigt der Reiter nur "nicht
# verbunden" und Spend muss manuell nachgetragen werden, nichts crasht.

# Meta Marketing API (Ads Insights) - getrennt von META_APP_ID/SECRET oben,
# die nur für Content-/Lead-Ads-Flows gelten:
#   1. business.facebook.com > Systembenutzer (Systemnutzer) anlegen
#   2. Diesem Systembenutzer das Werbekonto zuweisen, Rolle "Werbekonten
#      analysieren" reicht (kein Werbemanagement nötig)
#   3. "Neuen Token generieren" mit Scope ads_read, "Läuft nie ab" wählen
#   4. Werbekonto-ID (nur die Zahl, ohne "act_"-Präfix) aus dem Anzeigen-
#      manager-URL kopieren
META_ADS_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""

# Google Ads API:
#   1. Google Cloud Console (console.cloud.google.com) > OAuth-Client-ID/
#      Secret anlegen (Typ "Desktop-App" oder "Web", passend zum unten
#      verlinkten Playground) - Zugriff auf die Google Ads API hängt seit
#      der Developer-Token-Abschaffung durchs Google am 9.9.2026 am
#      Cloud-Projekt, nicht mehr an einem separaten Token; Zugriffslevel
#      kann direkt in der Cloud Console beantragt werden (kein Umweg mehr
#      über das API-Center im Google-Ads-Konto nötig)
#   2. Über den Google OAuth 2.0 Playground (developers.google.com/oauthplayground,
#      eigene Client-ID/Secret in den Einstellungen eintragen) mit Scope
#      "https://www.googleapis.com/auth/adwords" einmalig einloggen und den
#      Refresh-Token abgreifen
#   3. Customer-ID (10-stellig, ohne Bindestriche) aus dem Google-Ads-Konto
#   4. Falls das Konto unter einem Manager-Konto (MCC) hängt: dessen
#      Customer-ID zusätzlich als GOOGLE_ADS_LOGIN_CUSTOMER_ID setzen
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# LinkedIn Marketing API (Ad Analytics) - getrennt von LINKEDIN_CLIENT_ID/
# SECRET oben, die nur fürs organische Posten gelten. Braucht eine
# zusätzliche Freigabe der Marketing Developer Platform für Ads-Reporting-
# Scopes (r_ads_reporting) - bei LinkedIn beantragen, Freigabe kann Tage
# dauern. Der Access-Token läuft ohne eigenes Refresh-Token-Produkt nach
# ca. 60 Tagen ab und muss dann manuell erneuert werden.
#   1. Ads-Reporting-Scope (r_ads_reporting) für die bestehende LinkedIn-App
#      freischalten lassen (oder eine zweite App dafür anlegen)
#   2. Access-Token mit diesem Scope erzeugen (z.B. über den OAuth-Flow der
#      App, analog zum bestehenden LinkedIn-Connect in den Einstellungen)
#   3. Werbekonto-ID (nur die Zahl) aus dem LinkedIn Campaign Manager
LINKEDIN_ADS_ACCESS_TOKEN=""
LINKEDIN_AD_ACCOUNT_ID=""
